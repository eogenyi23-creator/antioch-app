# ---------- Web ----------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet

# ---------- API ----------
PORT=5000
DATABASE_URL=postgresql://antioch:antioch@localhost:5432/antioch
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too
CORS_ORIGIN=http://localhost:3000

# ---------- Stellar ----------
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# WASM hash of the antioch-escrow build used when deploying new campaign contracts
ESCROW_WASM_HASH=dd5492141456f76eb9b6a2371bf4b3386d3eedbe2626274506569eafa1f9ce46
# Low-balance platform account that signs deploy transactions only — never holds user funds
DEPLOYER_SECRET=
# Showcase / demo contract ID (read-only); real campaigns each store their own contract_id
ESCROW_CONTRACT_ID=CDVECNXDBALTJUXWXLHINICDG3V4FNSYZ24IJSKKLESHX323VRII2BHP
# Token SAC contract ID (test token in dev; swap for USDC SAC on mainnet)
TOKEN_CONTRACT_ID=CC6MCT6QYA4O2CEDABD43IL5A3L3ODATL4FZLDGTPOMK3GS4RE5BH67D
# USDC issuer for the chosen network
USDC_ISSUER=GD3GCXWPPA6ZIGQGU6L4QPHVAJZKKJFPN7YFD4YZNKR23XFBNIO4DLR2
USDC_ASSET_CODE=DEMO

# ---------- Fee sponsorship (optional) ----------
FEE_SPONSOR_ENABLED=false
# Low-balance account that only signs the fee-bump wrapper
FEE_SPONSOR_SECRET=
FEE_SPONSOR_MAX_PER_TX_STROOPS=
FEE_SPONSOR_MAX_PER_DAY_STROOPS=
FEE_SPONSOR_MAX_PER_USER_PER_DAY_STROOPS=

# ---------- Verifier (optional) ----------
VERIFIER_URL=http://localhost:8000
SERVICE_AUTH_KEY=change-me-shared-secret
# Only needed if the verifier uses a hosted model
MODEL_API_KEY=

# ---------- Uploads ----------
# Evidence file storage (S3-compatible or Cloudinary); leave empty to use local ./uploads in dev
STORAGE_URL=
